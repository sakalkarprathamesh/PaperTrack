# PaperTrack Environment Configuration (Template)
# Do NOT put real credentials here. Copy this file to .env.local for local development.

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_AGENCY_NAME=Your Agency Name
NEXT_PUBLIC_AGENCY_PHONE=Your Agency Phone Number
NEXT_PUBLIC_DEFAULT_DAILY_RATE=5
NEXT_PUBLIC_ENABLE_DEMO_SWITCHER=false
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
